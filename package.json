{
  "name": "@piyus/tasklog",
  "version": "0.2.0",
  "description": "Keyboard-first daily task log for the terminal. Stores tasks as month/day markdown files.",
  "type": "module",
  "bin": {
    "tasklog": "src/cli/main.tsx"
  },
  "files": [
    "src",
    "tsconfig.json"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "start": "bun src/cli/main.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "bun run typecheck && bun test && bun run format:check",
    "pack:check": "npm pack --dry-run",
    "release": "npm publish"
  },
  "keywords": [
    "todo",
    "tasks",
    "tui",
    "terminal",
    "opentui",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiyushRepos/tasklog.git"
  },
  "homepage": "https://github.com/PiyushRepos/tasklog#readme",
  "bugs": {
    "url": "https://github.com/PiyushRepos/tasklog/issues"
  },
  "dependencies": {
    "@opentui/core": "^0.5.17",
    "@opentui/react": "^0.5.17",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.0"
  },
  "author": "Piyush Kumar",
  "publishConfig": {
    "access": "public"
  }
}
